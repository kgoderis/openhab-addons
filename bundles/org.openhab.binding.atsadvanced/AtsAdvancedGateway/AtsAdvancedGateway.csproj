<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AtsAdvancedGateway</RootNamespace>
    <AssemblyName>AtsAdvancedGateway</AssemblyName>
    <RuntimeIdentifiers>osx-arm64;osx-x64;linux-arm64;linux-x64</RuntimeIdentifiers>
    <DefaultItemExcludes>$(DefaultItemExcludes);tools/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="NAce.Api"><HintPath>Library\NAce.Api.dll</HintPath></Reference>
    <Reference Include="NAce.Ats"><HintPath>Library\NAce.Ats.dll</HintPath></Reference>
    <Reference Include="NAce.Communication"><HintPath>Library\NAce.Communication.dll</HintPath></Reference>
    <Reference Include="NAce.Message"><HintPath>Library\NAce.Message.dll</HintPath></Reference>
    <Reference Include="NAce.Utilities"><HintPath>Library\NAce.Utilities.dll</HintPath></Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="ats.advanced.drv" CopyToOutputDirectory="PreserveNewest" />
    <None Include="kernel32.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('kernel32.dll')" />
    <None Include="libkernel32.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('libkernel32.dll')" />
  </ItemGroup>

  <!-- BeginInvoke → ThreadPool: build helper, patch NAce.Utilities from .orig, ship helper next to gateway -->
  <PropertyGroup>
    <_FireLibProj>$(MSBuildThisFileDirectory)tools/NetCoreAsyncFireLib/NetCoreAsyncFireLib.csproj</_FireLibProj>
    <_FireLibDll>$(MSBuildThisFileDirectory)tools/NetCoreAsyncFireLib/bin/Release/netstandard2.0/NetCoreAsyncFireLib.dll</_FireLibDll>
    <_PatchProj>$(MSBuildThisFileDirectory)tools/PatchNAceBeginInvoke/PatchNAceBeginInvoke.csproj</_PatchProj>
  </PropertyGroup>
  <Target Name="PatchNAceUtilities" BeforeTargets="ResolveAssemblyReferences" Condition="Exists('Library\\NAce.Utilities.dll.orig')">
    <Exec Command="dotnet build &quot;$(_FireLibProj)&quot; -c Release -v q" />
    <Exec Command="dotnet run --project &quot;$(_PatchProj)&quot; -c Release -v q -- &quot;$(MSBuildThisFileDirectory)Library/NAce.Utilities.dll.orig&quot; &quot;$(MSBuildThisFileDirectory)Library/NAce.Utilities.dll&quot; &quot;$(_FireLibDll)&quot;" />
    <Copy SourceFiles="$(_FireLibDll)" DestinationFolder="$(MSBuildThisFileDirectory)Library" SkipUnchangedFiles="true" />
    <ItemGroup>
      <None Include="$(_FireLibDll)" CopyToOutputDirectory="PreserveNewest" Link="NetCoreAsyncFireLib.dll" />
    </ItemGroup>
  </Target>
</Project>



