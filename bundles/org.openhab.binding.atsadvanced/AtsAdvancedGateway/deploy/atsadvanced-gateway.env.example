# Copy next to the installed bits as atsadvanced-gateway.env and source from a custom wrapper if needed.
ATS_GATEWAY_HOME=/usr/local/opt/atsadvanced-gateway
DOTNET_ROOT=/opt/homebrew/opt/dotnet@8/libexec
ASPNETCORE_URLS=http://127.0.0.1:18137
DOTNET_ENVIRONMENT=Production

