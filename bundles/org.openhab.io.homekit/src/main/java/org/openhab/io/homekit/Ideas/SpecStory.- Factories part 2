        try (DirectoryStream<Path> stream = Files.newDirectoryStream(configPath, "*.yml")) {
            for (Path path : stream) {
                try {
                    HomekitYamlConfig yamlConfig = yamlMapper.readValue(path.toFile(), HomekitYamlConfig.class);
