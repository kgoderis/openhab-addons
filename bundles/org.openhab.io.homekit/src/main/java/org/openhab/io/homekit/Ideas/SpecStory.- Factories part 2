@Component(service = HomekitCharacteristicFactory.class)
public class HomekitCharacteristicFactoryImpl implements HomekitCharacteristicFactory {
    private static final Map<String, Class<? extends AbstractHomekitCharacteristic>> TYPE_TO_CLASS = Map.of(
        "00000025-0000-1000-8000-0026BB765291", HomekitOnCharacteristic.class,
        "00000008-0000-1000-8000-0026BB765291", HomekitBrightnessCharacteristic.class
    );
    
    @Reference
    private HomekitCharacteristicConfig config;
    
    private final Map<String, CharacteristicMapping> directMappings = new ConcurrentHashMap<>();
    private final Map<String, CharacteristicRules> characteristicRules = new ConcurrentHashMap<>();
    
    @Override
    public HomekitCharacteristic createCharacteristicForChannel(Channel channel, 
                                                              HomekitService service,
                                                              Thing thing) {
        String channelType = channel.getChannelTypeUID().toString();
        
        // Try direct mapping first
        CharacteristicMapping directMapping = directMappings.get(channelType);
        if (directMapping != null) {
            return createCharacteristic(directMapping.getType(), service);
        }
        
        // If no direct mapping, use scoring system
        String bestType = findBestCharacteristicType(channel, thing);
        if (bestType != null) {
            return createCharacteristic(bestType, service);
        }
        
        throw new HomekitException(
            String.format("No characteristic mapping found for channel type %s", channelType));
    }
    
    private String findBestCharacteristicType(Channel channel, Thing thing) {
        Map<String, Integer> scores = new HashMap<>();
        
        for (Map.Entry<String, CharacteristicRules> entry : characteristicRules.entrySet()) {
            String type = entry.getKey();
            CharacteristicRules rules = entry.getValue();
            
            int score = calculateScore(channel, thing, rules);
            scores.put(type, score);
        }
        
        return scores.entrySet().stream()
            .max(Map.Entry.comparingByValue())
            .map(Map.Entry::getKey)
            .orElse(null);
    }
    
    private int calculateScore(Channel channel, Thing thing, CharacteristicRules rules) {
        int score = 0;
        
        // Binding score
        String bindingId = channel.getUID().getBindingId();
        Integer bindingScore = rules.getScoring().getBinding().get(bindingId);
        if (bindingScore != null) {
            score += bindingScore;
        }
        
        // Item type score
        Set<Item> linkedItems = linkRegistry.getLinkedItems(channel.getUID());
        for (Item item : linkedItems) {
            Integer itemTypeScore = rules.getScoring().getItemTypes().get(item.getType());
            if (itemTypeScore != null) {
                score += itemTypeScore;
                break;
            }
        }
        
        // Semantic property score
        SemanticTags semanticTags = channel.getChannelType().getSemanticTags();
        if (semanticTags != null) {
            for (String property : semanticTags.getProperties()) {
                Integer semanticScore = rules.getScoring().getSemanticProperties().get(property);
                if (semanticScore != null) {
                    score += semanticScore;
                    break;
                }
            }
        }
        
        // Channel properties score
        Map<String, String> properties = channel.getProperties();
        for (Map.Entry<String, String> prop : properties.entrySet()) {
            String propKey = prop.getKey() + "=" + prop.getValue();
            Integer propScore = rules.getScoring().getChannelProperties().get(propKey);
            if (propScore != null) {
                score += propScore;
            }
        }
        
        // Channel tags score
        Set<String> tags = channel.getTags();
        for (String tag : tags) {
            Integer tagScore = rules.getScoring().getChannelTags().get(tag);
            if (tagScore != null) {
                score += tagScore;
            }
        }
        
        // State description score
        StateDescription stateDescription = channel.getChannelType().getState();
        if (stateDescription != null) {
            StateDescriptionRules stateRules = rules.getScoring().getStateDescription();
            if (stateDescription.getPattern().equals(stateRules.getPattern())) {
                score += 50;
            }
            if (stateDescription.getMinimum().equals(stateRules.getMin()) &&
                stateDescription.getMaximum().equals(stateRules.getMax())) {
                score += 30;
            }
            if (stateDescription.getStep().equals(stateRules.getStep())) {
                score += 20;
            }
        }
        
        return score;
    }
}
