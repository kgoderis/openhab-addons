            for (Configuration config : configs) {
                Dictionary<String, Object> properties = config.getProperties();
                if (properties != null) {
                    String pid = (String) properties.get("service.pid");
                    configurations.put(pid, new HomekitConfiguration(properties));
                }
            }
        }
