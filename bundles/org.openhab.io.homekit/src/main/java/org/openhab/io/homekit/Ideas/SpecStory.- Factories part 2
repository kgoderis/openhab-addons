@Component(service = HomekitConfigurationVersionManager.class)
public class HomekitConfigurationVersionManager {
    private final Logger logger = LoggerFactory.getLogger(HomekitConfigurationVersionManager.class);
    private final HomekitConfigurationService configService;
    private final Map<String, ConfigurationMigration> migrations = new HashMap<>();
    
    @Activate
    public HomekitConfigurationVersionManager(@Reference HomekitConfigurationService configService) {
        this.configService = configService;
        registerMigrations();
    }
    
    private void registerMigrations() {
        migrations.put("1.0.0", new ConfigurationMigration() {
            @Override
            public Dictionary<String, Object> migrate(Dictionary<String, Object> oldConfig) {
                Dictionary<String, Object> newConfig = new Hashtable<>();
                // Copy existing properties
                Enumeration<String> keys = oldConfig.keys();
                while (keys.hasMoreElements()) {
                    String key = keys.nextElement();
                    newConfig.put(key, oldConfig.get(key));
                }
                
                // Add new properties or modify existing ones
                newConfig.put("version", "1.1.0");
                newConfig.put("newProperty", "defaultValue");
                
                return newConfig;
            }
        });
    }
    
    public void checkAndMigrate(String pid) {
        HomekitConfiguration config = configService.getConfiguration(pid);
        if (config == null) {
            return;
        }
        
        String currentVersion = config.getVersion();
        ConfigurationMigration migration = migrations.get(currentVersion);
        
        if (migration != null) {
            try {
                Dictionary<String, Object> newConfig = migration.migrate(config.getProperties());
                configService.updateConfiguration(pid, newConfig);
                logger.info("Successfully migrated configuration {} from version {} to {}", 
                    pid, currentVersion, newConfig.get("version"));
            } catch (Exception e) {
                logger.error("Failed to migrate configuration {}", pid, e);
            }
        }
    }
}

public interface ConfigurationMigration {
    Dictionary<String, Object> migrate(Dictionary<String, Object> oldConfig);
}
