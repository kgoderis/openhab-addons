public class HomekitConfigurationValidator {
    private final Logger logger = LoggerFactory.getLogger(HomekitConfigurationValidator.class);
    
    public ValidationResult validate(HomekitConfiguration config) {
        ValidationResult result = new ValidationResult();
        
        // Validate version
        if (!isValidVersion(config.getVersion())) {
            result.addError("version", "Invalid version format");
        }
        
        // Validate port
        int port = (int) config.getProperty("port");
        if (port < 1024 || port > 65535) {
            result.addError("port", "Port must be between 1024 and 65535");
        }
        
        // Validate PIN format
        String pin = (String) config.getProperty("pin");
        if (!isValidPin(pin)) {
            result.addError("pin", "PIN must be in format XXX-XX-XXX");
        }
        
        // Validate name
        String name = (String) config.getProperty("name");
        if (name == null || name.trim().isEmpty()) {
            result.addError("name", "Name cannot be empty");
        }
        
        return result;
    }
    
    private boolean isValidVersion(String version) {
        return version != null && version.matches("\\d+\\.\\d+\\.\\d+");
    }
    
    private boolean isValidPin(String pin) {
        return pin != null && pin.matches("\\d{3}-\\d{2}-\\d{3}");
    }
}

