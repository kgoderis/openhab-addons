@Component(service = HomekitCharacteristicFactory.class)
public class HomekitCharacteristicFactoryImpl implements HomekitCharacteristicFactory {
    private static final Map<String, Class<? extends AbstractHomekitCharacteristic>> TYPE_TO_CLASS = Map.of(
        "00000025-0000-1000-8000-0026BB765291", HomekitOnCharacteristic.class,
        "00000008-0000-1000-8000-0026BB765291", HomekitBrightnessCharacteristic.class
    );
    
    @Reference
    private HomekitCharacteristicConfig config;
    
    private final List<ChannelMapping> mappings = new ArrayList<>();
    
    @Activate
    public void activate() {
        loadConfiguration();
    }
    
    private void loadConfiguration() {
        mappings.clear();
        
        for (Map.Entry<String, ChannelMapping> entry : config.getMappings().entrySet()) {
            String pattern = entry.getKey();
            ChannelMapping mapping = entry.getValue();
            
            // Convert pattern to regex
            String regex = pattern.replace("*", ".*");
            mappings.add(new ChannelMapping(
                Pattern.compile(regex),
                mapping
            ));
        }
        
        // Sort mappings by specificity (more specific patterns first)
        mappings.sort((a, b) -> {
            String patternA = a.pattern.pattern();
            String patternB = b.pattern.pattern();
            return Integer.compare(
                patternB.split("\\*").length,  // More segments = more specific
                patternA.split("\\*").length
            );
        });
    }
    
    @Override
    public HomekitCharacteristic createCharacteristicForChannel(Channel channel, 
                                                              HomekitService service,
                                                              Thing thing) {
        String channelType = channel.getChannelTypeUID().toString();
        
        // Find best matching mapping
        ChannelMapping bestMapping = findBestMapping(channel, channelType);
        
        if (bestMapping == null) {
            throw new HomekitException(
                String.format("No characteristic mapping found for channel type %s", channelType));
        }
        
        return createCharacteristic(bestMapping.mapping.getType(), service);
    }
    
    private ChannelMapping findBestMapping(Channel channel, String channelType) {
        for (ChannelMapping mapping : mappings) {
            if (mapping.pattern.matcher(channelType).matches()) {
                // Check additional matching criteria
                if (matchesProperties(channel, mapping.mapping) &&
                    matchesTags(channel, mapping.mapping) &&
                    matchesSemanticProperties(channel, mapping.mapping)) {
                    return mapping;
                }
            }
        }
        return null;
    }
    
    private boolean matchesProperties(Channel channel, ChannelMapping mapping) {
        if (mapping.getMatch() == null || mapping.getMatch().getProperties() == null) {
            return true;
        }
        
        Map<String, String> properties = channel.getProperties();
        return mapping.getMatch().getProperties().stream()
            .anyMatch(prop -> {
                String[] keyValue = prop.split("=");
                return keyValue.length == 2 &&
                       keyValue[1].equals(properties.get(keyValue[0]));
            });
    }
    
    private boolean matchesTags(Channel channel, ChannelMapping mapping) {
        if (mapping.getMatch() == null || mapping.getMatch().getTags() == null) {
            return true;
        }
        
        Set<String> tags = channel.getTags();
        return mapping.getMatch().getTags().stream()
            .anyMatch(tags::contains);
    }
    
    private boolean matchesSemanticProperties(Channel channel, ChannelMapping mapping) {
        if (mapping.getMatch() == null || mapping.getMatch().getSemanticProperties() == null) {
            return true;
        }
        
        SemanticTags semanticTags = channel.getChannelType().getSemanticTags();
        if (semanticTags == null) {
            return false;
        }
        
        return mapping.getMatch().getSemanticProperties().stream()
            .anyMatch(semanticTags.getProperties()::contains);
    }
    
    private static class ChannelMapping {
        final Pattern pattern;
        final ChannelMapping mapping;
        
        ChannelMapping(Pattern pattern, ChannelMapping mapping) {
            this.pattern = pattern;
            this.mapping = mapping;
        }
    }
}
