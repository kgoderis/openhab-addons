@Component(service = HomekitConfigurationService.class)
public class HomekitConfigurationService {
    private final Logger logger = LoggerFactory.getLogger(HomekitConfigurationService.class);
    private final ObjectMapper yamlMapper;
    private final Map<String, Object> configurations = new ConcurrentHashMap<>();
    private final Path configBasePath;
    
    @Activate
    public HomekitConfigurationService() {
        this.yamlMapper = new ObjectMapper(new YAMLFactory());
        this.configBasePath = Paths.get("conf/homekit");
        loadConfigurations();
    }
    
    private void loadConfigurations() {
        try {
            if (!Files.exists(configBasePath)) {
                logger.warn("HomeKit configuration directory not found at {}", configBasePath);
                return;
            }
            
            Files.walk(configBasePath)
                .filter(path -> path.toString().endsWith(".yml") || path.toString().endsWith(".yaml"))
                .forEach(this::loadConfigurationFile);
                
        } catch (IOException e) {
            logger.error("Failed to load configurations", e);
        }
    }
    
    private void loadConfigurationFile(Path configPath) {
        try {
            String configKey = getConfigKey(configPath);
            Object config = yamlMapper.readValue(configPath.toFile(), Object.class);
            configurations.put(configKey, config);
            logger.debug("Loaded configuration from {} as {}", configPath, configKey);
        } catch (Exception e) {
            logger.error("Failed to load configuration from {}", configPath, e);
        }
    }
    
    private String getConfigKey(Path configPath) {
        // Convert path to key, e.g., conf/homekit/characteristic-mappings.yml -> characteristic-mappings
        String fileName = configPath.getFileName().toString();
        return fileName.substring(0, fileName.lastIndexOf('.'));
    }
    
    public <T> T getConfiguration(String key, Class<T> type) {
        Object config = configurations.get(key);
        if (config == null) {
            return null;
        }
        
        try {
            return yamlMapper.convertValue(config, type);
        } catch (IllegalArgumentException e) {
            logger.error("Failed to convert configuration {} to type {}", key, type.getName(), e);
            return null;
        }
    }
    
    public <T> Optional<T> getConfigurationOptional(String key, Class<T> type) {
        return Optional.ofNullable(getConfiguration(key, type));
    }
    
    public void reloadConfiguration(String key) {
        Path configPath = configBasePath.resolve(key + ".yml");
        if (Files.exists(configPath)) {
            loadConfigurationFile(configPath);
        } else {
            logger.warn("Configuration file not found for key: {}", key);
        }
    }
    
    public void reloadAllConfigurations() {
        configurations.clear();
        loadConfigurations();
    }
