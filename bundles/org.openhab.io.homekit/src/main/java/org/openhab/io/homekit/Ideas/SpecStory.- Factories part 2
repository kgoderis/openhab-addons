private void updateCharacteristicValue(Characteristic<?> characteristic, State state) {
    String itemName = characteristic.getService().getAccessory().getUID().toString();
    long now = System.currentTimeMillis();
    
    // Check if we're in a cooldown period
    Long lastChange = lastStateChangeTime.get(itemName);
    if (lastChange != null && (now - lastChange) < STATE_CHANGE_COOLDOWN_MS) {
