public class NonOSGiClass {
    private final HomekitFactory accessoryFactory;
    private final HomekitFactory serviceFactory;
    private final HomekitFactory characteristicFactory;
    
    public NonOSGiClass(BundleContext bundleContext) {
        // Get services directly from bundle context
        this.accessoryFactory = getFactory(bundleContext, HomekitFactoryType.ACCESSORY);
        this.serviceFactory = getFactory(bundleContext, HomekitFactoryType.SERVICE);
        this.characteristicFactory = getFactory(bundleContext, HomekitFactoryType.CHARACTERISTIC);
